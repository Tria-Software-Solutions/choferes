# ============================================
# Docker Compose environment
# Copy this file to .env and fill in your values
# ============================================

POSTGRES_USER=choferes
POSTGRES_PASSWORD=changeme
POSTGRES_DB=choferes_dev

# JWT Secrets (min 32 characters each) — obligatorios para arrancar la API
# Generar con: openssl rand -hex 64
JWT_SECRET_KEY=your_32_char_min_secret_key_here
JWT_SECRET_KEY_REFRESH=your_32_char_min_refresh_secret_here

NODE_ENV=development
PORT=5000
REACT_APP_API_URL=http://localhost:5001
