# ============================================
# Frontend Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# Backend API URL (dev local; en Vercel apunta al backend desplegado)
REACT_APP_API_URL=http://localhost:5000

# UI URL (para CORS del backend)
REACT_APP_UI_URL=http://localhost:3000

# NOTA: las API keys de Gemini/OCR se movieron al backend (GEMINI_API_KEY).
# El frontend las consume vía el proxy /api/vision/gemini y ya no se exponen
# en el bundle.
