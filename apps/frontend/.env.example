# ============================================
# Frontend Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# Backend API URL (dev local; en Vercel apunta al backend desplegado)
REACT_APP_API_URL=http://localhost:5000

# UI URL (para CORS del backend)
REACT_APP_UI_URL=http://localhost:3000

# OCR (ocr.space) — clave de API
REACT_APP_OCR_API_KEY=your_ocr_space_api_key
REACT_APP_OCR_API_URL=https://api.ocr.space/parse/image

# Google Gemini — clave de API (AIza...)
REACT_APP_GEMINI_API_KEY=your_gemini_api_key
