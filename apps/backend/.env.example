# ============================================
# Backend Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# Node Environment (development, test, production)
NODE_ENV=development

# Server Port
PORT=5000

# Database Configuration (PostgreSQL) — opción 1: variables individuales
PGHOST=localhost
PGUSER=your_db_username
PGPASSWORD=your_db_password
PGDATABASE=your_db_name

# Database Configuration — opción 2: connection string completa (Render/Neon/Heroku)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Secrets (min 32 characters each)
# Generar con: openssl rand -hex 64
JWT_SECRET_KEY=your_32_char_min_secret_key_here
JWT_SECRET_KEY_REFRESH=your_32_char_min_refresh_secret_here

# Frontend URL (for CORS)
REACT_APP_UI_URL=http://localhost:3000

# Contraseñas del seeder (solo si se corre db:seed; obligatorias en producción, min 12 chars)
# SEED_ADMIN_PASSWORD=
# SEED_MANAGEMENT_PASSWORD=
# SEED_CUSTOMER_SERVICE_PASSWORD=
