# ============================================
# Backend Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# Node Environment (development, test, production)
NODE_ENV=development

# Server Port
PORT=5000

# Database Configuration (PostgreSQL) — opción 1: variables individuales
PGHOST=localhost
PGUSER=your_db_username
PGPASSWORD=your_db_password
PGDATABASE=your_db_name

# Database Configuration — opción 2: connection string completa (Render/Neon/Heroku)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Secrets (min 32 characters each)
# Generar con: openssl rand -hex 64
JWT_SECRET_KEY=your_32_char_min_secret_key_here
JWT_SECRET_KEY_REFRESH=your_32_char_min_refresh_secret_here

# Frontend URL (for CORS)
REACT_APP_UI_URL=http://localhost:3000


# Email (Resend) — envío real de boletas de pago desde la app
# API key de https://resend.com
# OBLIGATORIA en producción: sin ella sendPaymentSlipEmail responde 503.
RESEND_API_KEY=your_resend_api_key
# Remitente de la boleta. Debe usar un dominio verificado en Resend, o el
# envío falla con 403. Sin esta variable el backend lanza error en producción
# (solo en desarrollo cae a onboarding@resend.dev, que solo entrega a la
# cuenta propietaria de la API key).
EMAIL_FROM=Choferes <info@choferesdealquiler.com>

# ============================================
# Scheduler Configuration (node-cron)
# Timezone: America/Costa_Rica (no DST)
# ============================================
# Timezone for all cron jobs
SCHEDULER_TZ=America/Costa_Rica

# Payroll job: daily at 02:00 CR (catches quincena corrections overnight)
PAYROLL_SCHEDULE=0 2 * * *

# Reminder job: every 5 minutes
REMINDER_SCHEDULE=*/5 * * * *

# Termination job: daily at 03:00 CR
TERMINATION_SCHEDULE=0 3 * * *

# Disable all schedulers (useful for testing)
# DISABLE_SCHEDULERS=true

# Contraseñas del seeder (solo si se corre db:seed; obligatorias en producción, min 12 chars)
# SEED_ADMIN_PASSWORD=
# SEED_MANAGEMENT_PASSWORD=
# SEED_CUSTOMER_SERVICE_PASSWORD=
